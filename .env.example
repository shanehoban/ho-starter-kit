DB_PROVIDER=sqlite
DB_PATH=./sqlite.db
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ho_starter_kit
# If app runs inside Docker Compose with service name "postgres", use host "postgres" instead of "localhost".

 # Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
APP_NAME=ho-starter-kit
# Optional: nonce string used for CSP inline script authorization
# Generate: openssl rand -base64 24
# CSP_SCRIPT_NONCE=
# Optional extra allowed origins for Better Auth (comma-separated absolute origins)
# BETTER_AUTH_TRUSTED_ORIGINS=https://example.com,https://admin.example.com
EMAIL_PROVIDER=null
# EMAIL_PROVIDER=homail
# HOMAIL_BASE_URL=https://homail.shanehoban.com
# HOMAIL_API_KEY=hm_live_<keyId>_<secret>
# HOMAIL_FROM="Starter Kit <noreply@example.com>"
# FEEDBACK_TO_EMAIL=you@example.com
