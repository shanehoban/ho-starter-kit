{
  "name": "ho-starter-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm test",
    "verify:coverage": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm run test:coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:sqlite": "DB_PROVIDER=sqlite drizzle-kit generate",
    "db:push:sqlite": "DB_PROVIDER=sqlite drizzle-kit push",
    "db:migrate:sqlite": "DB_PROVIDER=sqlite drizzle-kit migrate",
    "db:generate:postgres": "DB_PROVIDER=postgres drizzle-kit generate",
    "db:push:postgres": "DB_PROVIDER=postgres drizzle-kit push",
    "db:migrate:postgres": "DB_PROVIDER=postgres drizzle-kit migrate",
    "db:apply-migrations": "node scripts/apply-migrations.js",
    "db:backup": "bash scripts/backup-db.sh",
    "db:check": "node scripts/check-db-integrity.js",
    "db:smoke": "bash scripts/db-smoke-test.sh",
    "db:safe-migrate": "bash scripts/safe-migrate.sh",
    "db:deploy-migrate": "bash scripts/deploy-migrate.sh",
    "db:test-migration-recovery": "node scripts/test-migration-recovery.js",
    "start:local:db": "docker compose -f docker-compose.postgres.yml up -d postgres",
    "stop:local:db": "docker compose -f docker-compose.postgres.yml down",
    "logs:local:db": "docker compose -f docker-compose.postgres.yml logs -f postgres",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "quality:check": "pnpm verify && pnpm naming:check && pnpm security:check && pnpm security:audit",
    "naming:check": "node scripts/check-naming.mjs",
    "security:audit": "bash -lc 'set -euo pipefail; audit_file=\"$(mktemp)\"; pnpm audit --json > \"$audit_file\" 2>&1 || true; node scripts/enforce-audit.mjs --audit-file \"$audit_file\"; rm -f \"$audit_file\"'",
    "security:check": "node scripts/security-check.mjs",
    "release:audit": "node scripts/release-audit.mjs --provider all",
    "release:check": "pnpm release:audit",
    "release:audit:sqlite": "node scripts/release-audit.mjs --provider sqlite",
    "release:audit:postgres": "node scripts/release-audit.mjs --provider postgres",
    "release:audit:postgres:ci": "USE_EXTERNAL_POSTGRES=1 node scripts/release-audit.mjs --provider postgres",
    "typecheck": "tsc --noEmit",
    "email:preview": "email dev --dir src/emails"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@shanehoban/homail": "^0.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "better-auth": "^1.6.16",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "nitro": "3.0.260603-beta",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@tanstack/devtools-vite": "^0.7.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
