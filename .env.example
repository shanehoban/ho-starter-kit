DB_PROVIDER=sqlite
DB_PATH=./sqlite.db
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ho_starter_kit
# If app runs inside Docker Compose with service name "postgres", use host "postgres" instead of "localhost".

 # Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional extra allowed origins for Better Auth (comma-separated absolute origins)
# BETTER_AUTH_TRUSTED_ORIGINS=https://example.com,https://admin.example.com
EMAIL_PROVIDER=null
# RESEND_API_KEY=
# EMAIL_FROM="Starter Kit <noreply@example.com>"
