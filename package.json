{
  "name": "ho-starter-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm test",
    "verify:coverage": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm run test:coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:sqlite": "DB_PROVIDER=sqlite drizzle-kit generate",
    "db:push:sqlite": "DB_PROVIDER=sqlite drizzle-kit push",
    "db:migrate:sqlite": "DB_PROVIDER=sqlite drizzle-kit migrate",
    "db:generate:postgres": "DB_PROVIDER=postgres drizzle-kit generate",
    "db:push:postgres": "DB_PROVIDER=postgres drizzle-kit push",
    "db:migrate:postgres": "DB_PROVIDER=postgres drizzle-kit migrate",
    "db:apply-migrations": "node scripts/apply-migrations.js",
    "db:backup": "bash scripts/backup-db.sh",
    "db:check": "node scripts/check-db-integrity.js",
    "db:smoke": "bash scripts/db-smoke-test.sh",
    "db:safe-migrate": "bash scripts/safe-migrate.sh",
    "db:deploy-migrate": "bash scripts/deploy-migrate.sh",
    "db:test-migration-recovery": "node scripts/test-migration-recovery.js",
    "start:local:db": "docker compose -f docker-compose.postgres.yml up -d postgres",
    "stop:local:db": "docker compose -f docker-compose.postgres.yml down",
    "logs:local:db": "docker compose -f docker-compose.postgres.yml logs -f postgres",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "quality:check": "pnpm verify && pnpm naming:check && pnpm security:check && pnpm security:audit",
    "naming:check": "node scripts/check-naming.mjs",
    "security:audit": "node scripts/enforce-audit.mjs",
    "security:check": "node scripts/security-check.mjs",
    "release:audit": "node scripts/release-audit.mjs --provider all",
    "release:check": "pnpm release:audit",
    "release:audit:sqlite": "node scripts/release-audit.mjs --provider sqlite",
    "release:audit:postgres": "node scripts/release-audit.mjs --provider postgres",
    "release:audit:postgres:ci": "USE_EXTERNAL_POSTGRES=1 node scripts/release-audit.mjs --provider postgres",
    "typecheck": "tsc --noEmit",
    "email:preview": "email dev --dir src/emails"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@shanehoban/homail": "^0.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "^1.7.15",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "nitro": "3.0.261029-rc",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "^0.8.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
