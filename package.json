{
  "name": "ho-starter-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.18.0 <21",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm test",
    "verify:coverage": "pnpm exec biome check . && pnpm exec tsc --noEmit && pnpm run test:coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:generate:sqlite": "DB_PROVIDER=sqlite drizzle-kit generate",
    "db:push:sqlite": "DB_PROVIDER=sqlite drizzle-kit push",
    "db:migrate:sqlite": "DB_PROVIDER=sqlite drizzle-kit migrate",
    "db:generate:postgres": "DB_PROVIDER=postgres drizzle-kit generate",
    "db:push:postgres": "DB_PROVIDER=postgres drizzle-kit push",
    "db:migrate:postgres": "DB_PROVIDER=postgres drizzle-kit migrate",
    "db:apply-migrations": "node scripts/apply-migrations.js",
    "db:backup": "bash scripts/backup-db.sh",
    "db:check": "node scripts/check-db-integrity.js",
    "db:smoke": "bash scripts/db-smoke-test.sh",
    "db:safe-migrate": "bash scripts/safe-migrate.sh",
    "db:deploy-migrate": "bash scripts/deploy-migrate.sh",
    "db:test-migration-recovery": "node scripts/test-migration-recovery.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "email:preview": "email dev --dir src/emails"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.9.5",
    "@tanstack/react-router": "^1.160.2",
    "@tanstack/react-router-devtools": "^1.160.2",
    "@tanstack/react-router-ssr-query": "^1.160.2",
    "@tanstack/react-start": "^1.162.8",
    "@tanstack/router-plugin": "^1.160.2",
    "better-auth": "^1.4.18",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.564.0",
    "nitro": "npm:nitro-nightly@latest",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^5.2.8",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.3.6",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@react-email/preview-server": "5.2.8",
    "@tanstack/devtools-vite": "^0.5.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.9",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
